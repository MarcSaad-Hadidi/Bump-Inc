{
  "name": "bump-consultation",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "previews": {},
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "contactmarchadidi@gmail.com"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "332034",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
