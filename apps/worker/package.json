{
  "name": "@bump/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bump/contracts": "workspace:*",
    "@bump/core": "workspace:*",
    "@bump/db": "workspace:*",
    "@bump/integrations": "workspace:*",
    "@bump/observability": "workspace:*",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  },
  "files": [
    "dist"
  ]
}
