    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bump/contracts": "workspace:*",
    "@bump/core": "workspace:*",
    "@bump/db": "workspace:*",
    "@bump/identity": "workspace:*",
    "@bump/integrations": "workspace:*",
    "@bump/observability": "workspace:*",
    "@bump/worker": "workspace:*",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "better-auth": "1.7.12",
    "bullmq": "5.81.5",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "5.11.1",
    "pdfkit": "0.20.2",
    "zod": "4.6.7"
  },
  "files": [
    "dist",
    "assets"
  ],
  "devDependencies": {
    "@types/pdfkit": "0.17.7"
