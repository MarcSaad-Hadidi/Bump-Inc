# Dedicated disposable test database; integration tests must never use customer databases.
NODE_ENV=test
LOG_LEVEL=silent
HOST=127.0.0.1
API_PORT=3001
WORKER_PORT=3002
WORKER_CONCURRENCY=2
DATABASE_URL=postgresql://bump_app:bump_local_runtime_only@127.0.0.1:5432/bump_test
MIGRATION_DATABASE_URL=postgresql://bump:bump_local_development_only@127.0.0.1:5432/bump_test
REDIS_URL=redis://127.0.0.1:6379/1
API_INTERNAL_URL=http://127.0.0.1:3001
AUTH_SECRET=local-test-only-change-this-secret-value
AUTH_BASE_URL=http://127.0.0.1:3001
AUTH_ALLOW_SIGNUP=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=noreply@bump.local
ARTIFACT_BACKEND=local
ARTIFACT_LOCAL_ROOT=../../.artifacts/test-audit-objects
# Disposable loopback S3 service started by pnpm infra:up; never use a real bucket here.
S3_TEST_ENDPOINT=http://127.0.0.1:8333
S3_TEST_BUCKET=bump-ingestion-test
S3_TEST_ACCESS_KEY_ID=bump_ci_disposable
S3_TEST_SECRET_ACCESS_KEY=bump_ci_s3_disposable_only
