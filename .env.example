# Local disposable infrastructure only. Never reuse these credentials in a shared environment.
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
API_PORT=3001
WORKER_PORT=3002
WORKER_CONCURRENCY=2
POSTGRES_USER=bump
POSTGRES_PASSWORD=bump_local_development_only
POSTGRES_DB=bump
DATABASE_URL=postgresql://bump:bump_local_development_only@127.0.0.1:5432/bump
REDIS_URL=redis://127.0.0.1:6379
API_INTERNAL_URL=http://127.0.0.1:3001
