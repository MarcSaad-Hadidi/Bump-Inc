{
  "name": "@bump/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
