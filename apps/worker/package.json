{
  "name": "@bump/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bump/contracts": "workspace:*",
    "@bump/db": "workspace:*",
    "@bump/observability": "workspace:*",
    "bullmq": "5.81.5",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "pino": "10.4.0"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./loi25": {
      "types": "./dist/scanners/loi25/index.d.ts",
      "default": "./dist/scanners/loi25/index.js"
    }
  }
}
